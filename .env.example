APP_NAME="Condomínio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=condominio
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Condomínio ---------------------------------------------------------------
# Disco dos documentos (PDFs, comprovantes, .eml). Produção: s3 (bucket com versionamento
# e Object Lock em modo governance). Sem isso, os arquivos ficam em storage/app/private.
CONDOMINIO_DISCO=local
CONDOMINIO_DISCO_BACKUP=local

# Domínio que recebe as faturas (ap302-x8vd@<dominio>). Precisa de MX apontando para o SES.
FATURAS_DOMINIO=faturas.localhost

# SES → regra de recebimento (ação S3 + notificação SNS por HTTPS em /webhooks/email/sns).
# Sem o ARN, toda notificação SNS é recusada.
FATURAS_SNS_TOPIC_ARN=
FATURAS_SES_DISCO=s3

# Webhook genérico de e-mail bruto (/webhooks/email/bruto/<token>), ex.: Mailgun "store and
# forward" ou Cloudflare Email Worker. Vazio = desligado. Use 40+ caracteres aleatórios.
FATURAS_WEBHOOK_TOKEN=

# poppler-utils e qpdf. Sem o pdftotext, o PDF é lido pelo parser PHP (pior com colunas);
# sem o qpdf, PDF com senha vai para revisão.
PDFTOTEXT_BIN=pdftotext
QPDF_BIN=qpdf

# Biometria (passkeys): domínio do site e origens aceitas.
PASSKEYS_RELYING_PARTY_ID=
PASSKEYS_ALLOWED_ORIGINS=

