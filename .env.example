APP_NAME="Condomínio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=condominio
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
RESEND_API_KEY=
# Endereço de um domínio verificado no Resend.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp para recuperação de senha (Gzappy).
GZAPPY_URL=https://v2-api.gzappy.com/
GZAPPY_API_KEY=
GZAPPY_TIMEOUT=15
GZAPPY_CONNECT_TIMEOUT=5

# S3 dos anexos (PDFs das faturas, comprovantes, prestação de contas e backups), como no
# sistema-ponto. Com AWS_BUCKET preenchido, o condomínio grava no bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Condomínio ---------------------------------------------------------------
# Disco dos documentos: s3 quando AWS_BUCKET está preenchido; sem bucket, storage/app/private.
# Só descomente para forçar outro disco. Arquivos gravados antes no disco local vão para o
# bucket com: php artisan condominio:arquivos-para-s3
# CONDOMINIO_DISCO=local
# CONDOMINIO_DISCO_BACKUP=local

# poppler-utils e qpdf. Sem o pdftotext, o PDF é lido pelo parser PHP (pior com colunas);
# sem o qpdf, PDF com senha vai para revisão.
PDFTOTEXT_BIN=pdftotext
QPDF_BIN=qpdf

# Biometria (passkeys): domínio do site e origens aceitas.
PASSKEYS_RELYING_PARTY_ID=
PASSKEYS_ALLOWED_ORIGINS=

